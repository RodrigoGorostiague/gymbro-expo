rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pushTokens/{userId} {
      allow read, write: if true;
    }
    match /kisses/{kissId} {
      allow read, write: if true;
    }
    match /equippedThemes/{userId} {
      allow read, write: if true;
    }
  }
}
